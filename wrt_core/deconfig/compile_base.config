# Compile
CONFIG_USE_APK=n
CONFIG_DEVEL=n
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# Proto
CONFIG_PACKAGE_proto-bonding=n
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=n
CONFIG_PACKAGE_libopenssl-legacy=y

# Disable Package
CONFIG_PACKAGE_automount=y

#  DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

#  Coremark
CONFIG_PACKAGE_coremark=n
CONFIG_COREMARK_OPTIMIZE_O3=n
CONFIG_COREMARK_ENABLE_MULTITHREADING=n
CONFIG_COREMARK_NUMBER_OF_THREADS=4

#  iptables nft
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# Package
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_lucky=n

# Enable Luci App
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_EASYTIER_INCLUDE_WEBCONSOLE=n
CONFIG_PACKAGE_luci-app-istorex=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
# 移除LuCI SMART管理页面
# CONFIG_PACKAGE_luci-app-smartmontools=y
# CONFIG_PACKAGE_luci-i18n-smartmontools-zh-cn=y

# 底层SMART工具+守护进程
# CONFIG_PACKAGE_smartmontools=y
# CONFIG_PACKAGE_smartd=y
# CONFIG_PACKAGE_smartd-mail=y
# 移除LuCI RAID磁盘阵列页面
# CONFIG_PACKAGE_luci-app-mdadm=y
# CONFIG_PACKAGE_luci-i18n-mdadm-zh-cn=y

# RAID管理工具mdadm
# CONFIG_PACKAGE_mdadm=y

# 内核RAID模块（含RAID5/4/6，不使用多盘阵列必须全关）
# CONFIG_PACKAGE_kmod-md-raid456=y
# CONFIG_PACKAGE_kmod-md-raid0=y
# CONFIG_PACKAGE_kmod-md-raid1=y
# CONFIG_PACKAGE_kmod-md-raid10=y
# CONFIG_PACKAGE_kmod-md-linear=y
# CONFIG_PACKAGE_kmod-md-multipath=y
# CONFIG_PACKAGE_kmod-dm-raid=y

