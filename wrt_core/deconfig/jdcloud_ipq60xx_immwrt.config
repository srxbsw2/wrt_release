# ====================== 平台&设备锁定 ======================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# 关键修复：取消剔除ath11k-pci无线驱动；预装无线固件+风扇LED控制
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="ipq-wifi-jdcloud_re-ss-01 ath11k-firmware-qcn9074-ddwrt kmod-ath11k-pci zram-swap luci-app-athena-led luci-i18n-athena-led-zh-cn"

# 其余京东云机型全部关闭，减少编译耗时
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=y
#CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ====================== ZRAM Swap 512M内存专属优化（核心） ======================
CONFIG_PACKAGE_zram-swap=y
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_ZRAM=y
CONFIG_ZRAM_DEFAULT_SIZE=786432    # 768M zram，物理内存1.5倍最优配比
CONFIG_ZRAM_ALGORITHM=lz4          # 压缩速度最快，CPU开销极低
CONFIG_KERNEL_SWAPINESS=60         # 内存占用60%开始使用交换，兼顾流畅+闪存寿命

# ====================== 内核文件系统模块 ======================
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_ntfs3-mount=y       # 原生NTFS读写，比ntfs-3g省大量CPU

# 网络隧道/诊断（OpenClash、L2TP、VPN必备不可删）
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-tun=y

# ====================== USB全套配置：开启USB3.0 + 彻底精简无用驱动 ======================
# 删掉：ehci/ohci USB1.1老旧控制器、4G网卡、iPhone RNDIS、串口调制解调器全家冗余驱动
# 新增USB3.0主驱动，阿瑟硬件原生USB3.0 Type-C完整启用
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb2=y
# 存储必备
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# 仅保留常用USB千兆网卡 RTL8153（你外接USB网卡刚需）
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# ====================== 系统工具包（删冗余、留运维刚需） ======================
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_resize2fs=y         # 刷机自动扩容64G EMMC全盘
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_smartmontools-drivedb=y # SSD健康状态监控

# 全部删除无用组件：usbmuxd、xl2tpd、qrencode、mii-tool

# ====================== Luci应用列表（已移除AdGuardHome） ======================
CONFIG_PACKAGE_luci-app-autoreboot=y
# 打印机不用可改为=n关闭瘦身
CONFIG_PACKAGE_luci-app-cupsd=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-emmc-health=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-samba4=y    # 局域网硬盘共享
CONFIG_PACKAGE_luci-app-sqm=y       # QoS游戏降延迟
# Windows激活不需要就改成=n
CONFIG_PACKAGE_luci-app-vlmcsd=y
# 风扇、指示灯自定义控制
CONFIG_PACKAGE_luci-app-athena-led=y
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y

# ====================== 新增内核全局优化项（适配阿瑟硬件） ======================
## 1. 固态硬盘IO调度
CONFIG_KERNEL_IOSCHED_DEADLINE=y
CONFIG_KERNEL_IOSCHED_NONE=y
CONFIG_DEFAULT_IOSCHED="deadline"

## 2. IPv6 + BBR拥塞算法（你的OpenClash刚需）
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_nlbwmon=y           # 流量统计
CONFIG_PACKAGE_tcping=y
CONFIG_KERNEL_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

## 3. 内存缓存调优，减少zram频繁写入磨损闪存
CONFIG_KERNEL_VMSCAN=y
